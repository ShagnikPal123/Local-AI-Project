# Copy this file to .env or .env.local and add only the keys you intend to use.
# Online providers (each is optional — configure only what you want):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# NVIDIA NIM (OpenAI-compatible). Free trial credits — keys at https://build.nvidia.com/models
# (you can also add it from the app: Models tab → Providers → "Get a key".)
NVIDIA_API_KEY=

# Optional per-provider model overrides:
# GEMINI_MODEL=gemini-2.5-flash
# FREE_ONLY=true                     — never auto-select paid models (claude/openai/kimi/deepseek/perplexity)
# PREFERRED_ONLINE_PROVIDER=gemini   — free first; falls back to groq, then local only
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_MODEL=moonshot-v1-8k
# GROQ_MODEL=llama-3.3-70b-versatile

# Local inference (Ollama) — no key required; set the model you have pulled:
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Preferred online fallback when local is unsuitable (claude, openai, gemini,
# kimi, deepseek, groq, perplexity):
PREFERRED_ONLINE_PROVIDER=claude
