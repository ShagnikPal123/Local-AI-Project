# The trader's own data: the practice account, settings, saved keys and logs. Never committed.
data/
*.log
# The built dashboard IS committed, so a download runs with Python alone (no Node.js needed).
# Rebuild it with `npm run build` in web/ whenever web/src changes, and commit the result.
!web/dist/
web/node_modules/
# Keys live in environment variables or data/secrets.json, never in a file in git.
.env
.env.*
tsconfig.tsbuildinfo
